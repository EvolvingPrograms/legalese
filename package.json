{
  "name": "legalese",
  "version": "0.17.0",
  "type": "module",
  "license": "MIT",
  "author": "Spellcraft Inc.",
  "private": true,
  "main": "dist/legalese.js",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    }
  },
  "bin": {
    "legalese": "dist/legalese.js"
  },
  "files": [
    "dist/",
    "examples/",
    "fonts/",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "bun test",
    "build": "bun build scripts/legalese.ts --target=node --minify --outfile=dist/legalese.js && chmod +x dist/legalese.js",
    "pack": "bun run build && zip -FSqr plugin.zip dist examples fonts README.md SKILL.md package.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "markdsl": "^0.0.2",
    "pandoc-wasm": "^1.0.1",
    "pre-commit": "^2.0.0"
  },
  "pre-commit": ["typecheck", "test"],
  "peerDependencies": {
    "typescript": "^5",
    "markdsl": "^0.0.2",
    "pandoc-wasm": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "markdsl": {
      "optional": true
    },
    "pandoc-wasm": {
      "optional": true
    }
  }
}